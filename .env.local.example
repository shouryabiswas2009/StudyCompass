NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Where auth emails send people back to. Defaults to
# http://localhost:3000; set it to your real URL once deployed.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Only needed to re-download official US data (npm run data:refresh-scorecard).
# Free key from https://api.data.gov/signup/. Never used by the running app.
SCORECARD_API_KEY=
