NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. The site's public address, used in auth email links and link
# previews. Leave it empty locally (http://localhost:3000 is used). On
# Vercel set it to your custom domain, e.g. https://www.example.com; if it's
# empty there, Vercel's own production domain is used instead.
NEXT_PUBLIC_SITE_URL=

# Only needed to re-download official US data (npm run data:refresh-scorecard).
# Free key from https://api.data.gov/signup/. Never used by the running app.
SCORECARD_API_KEY=
